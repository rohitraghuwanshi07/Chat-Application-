# PostgreSQL
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=5432
CHAT_DB_NAME=chatdb
CHAT_DB_USER=chatuser
CHAT_DB_PASS=CHANGE_ME

# Application
HOST=0.0.0.0
PORT=3306

# Distributed backend identity
